<!-- Notification icon: the app icon's ring and dot in white. Android draws small icons in one
     colour, so the gap around the dot is left out of the ring instead of painted over it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="64" android:viewportHeight="64">
    <group android:translateX="-22" android:translateY="-22">
        <!-- ring: centre 54,54, radius 22, stroke 7, open where the dot sits -->
        <path android:fillColor="#00000000" android:strokeColor="#FFFFFF" android:strokeWidth="7"
            android:strokeLineCap="round"
            android:pathData="M75.79,50.94 A22,22 0 1,1 57.06,32.21"/>
        <!-- dot: centre 69.5,38.5, radius 8 -->
        <path android:fillColor="#FFFFFF"
            android:pathData="M61.5,38.5 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"/>
    </group>
</vector>
